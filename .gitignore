bin/
obj/

[Bb]in/
[Oo]bj/

*.dll
*.exe
*.pdb
*.cache

artifacts/


# ==========================================================
# CONFIGURAÇÕES LOCAIS / SEGREDOS
# ==========================================================

appsettings.Development.json
appsettings.Local.json

.env
.env.*
!.env.example

secrets.json


# ==========================================================
# VISUAL STUDIO
# ==========================================================

.vs/

*.user
*.suo
*.userosscache
*.sln.docstates

_ReSharper*/
*.DotSettings.user


# ==========================================================
# VISUAL STUDIO CODE
# ==========================================================

.vscode/

# Se futuramente quiser versionar configurações específicas
# do VS Code, remova a regra acima e escolha os arquivos
# individualmente.


